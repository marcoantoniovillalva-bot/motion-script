# ─── API Keys — copia questo file in .env.local e inserisci le tue chiavi ───

# OBBLIGATORIA — Genera i JSON delle scene dal tuo copione
# Ottieni la tua chiave su: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-...

# OPZIONALE — Foto stock di alta qualità (gratis fino a 200 req/mese)
# Registrati su: https://www.pexels.com/api/
PEXELS_API_KEY=

# OPZIONALE — Foto stock aggiuntive (gratis)
# Registrati su: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# OPZIONALE — Screenshot browser di alta qualità (gratis con account free)
# Registrati su: https://apify.com
APIFY_API_TOKEN=
